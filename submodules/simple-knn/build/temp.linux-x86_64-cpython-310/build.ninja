ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.8/bin/nvcc

cflags = -pthread -B /home/wang/anaconda3/envs/fastgs/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/wang/anaconda3/envs/fastgs/include -fPIC -O2 -isystem /home/wang/anaconda3/envs/fastgs/include -fPIC -I/home/wang/anaconda3/envs/fastgs/lib/python3.10/site-packages/torch/include -I/home/wang/anaconda3/envs/fastgs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-12.8/include -I/home/wang/anaconda3/envs/fastgs/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_cflags = -I/home/wang/anaconda3/envs/fastgs/lib/python3.10/site-packages/torch/include -I/home/wang/anaconda3/envs/fastgs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-12.8/include -I/home/wang/anaconda3/envs/fastgs/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /home/wang/3dgs/FastGS/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/ext.o: compile /home/wang/3dgs/FastGS/submodules/simple-knn/ext.cpp
build /home/wang/3dgs/FastGS/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/simple_knn.o: cuda_compile /home/wang/3dgs/FastGS/submodules/simple-knn/simple_knn.cu
build /home/wang/3dgs/FastGS/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/spatial.o: cuda_compile /home/wang/3dgs/FastGS/submodules/simple-knn/spatial.cu








